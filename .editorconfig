root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = 140
# Package "in.rahulja.vision202020" starts with the Kotlin keyword "in" (ktlint flags it); renaming would break the application id.
ktlint_standard_package-name = disabled
# Composable functions are PascalCase by Compose convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Existing public lambda parameters (onXChanged, onHoldingChanged) are past tense by Material convention (onCheckedChange-style state callbacks)
# and are referenced by callers and tests; renaming them is out of scope.
ktlint_compose_parameter-naming = disabled
