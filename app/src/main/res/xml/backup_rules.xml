<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower: keep the disposable session and the crash log out of backups. -->
<full-backup-content>
    <exclude domain="file" path="datastore/vision_session.preferences_pb" />
    <exclude domain="file" path="crash-logs/last-crash.txt" />
</full-backup-content>
